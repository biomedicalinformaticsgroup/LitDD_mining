# transient training output_dir dirs written to the repo root by TrainingArguments
_*/
_hp_search_*.json
crossencoded_shards/
data/bert_processed/
data/pubmed_download/
# NCBI reissues the whole baseline each December under a new year prefix, so each corpus
# lives in its own directory (mixing years would duplicate every pre-2026 record downstream).
data/pubmed_download_*/

# Demo outputs (regenerated by run_pipeline.sh --demo); keep demo/data/*.csv tracked
demo/results/
demo/models/

# Benchmark output CSVs (regenerated)
litdd/evaluation/bert_results.csv
litdd/evaluation/cv_results.csv

# Precision-audit outputs: contain real abstracts / are annotator-facing — never commit
# (default output is the gitignored revision/ area; this is a belt-and-braces safety net)
**/*audit_worksheet*.csv
**/*audit_key*.csv
**/trainlabel_iaa_*.csv
**/dropped_set_worksheet.csv
**/precision_by_stratum.csv
**/error_categories.csv
**/cascade_funnel.csv

# HPO annotation: large ontology/index + regenerated data (code is tracked; data is not)
# hp.obo/hp.index built via FastHPOCR; full text is fetched with cadmus (publisher-permission, not shared)
litdd/hpo/hp.obo
litdd/hpo/hp.index
litdd/hpo/*.parquet
litdd/hpo/*.csv
litdd/hpo/litdd_pmids.txt
**/output/retrieved_df/
**/output/retrieved_parsed_files/

# Visualisation: large embedding/ontology artefacts + rendered outputs (scripts/notebook are tracked)
visualisation/*.parquet
visualisation/*.csv
visualisation/*.html
visualisation/*.png
visualisation/*.obo
visualisation/*.owl
visualisation/*.txt
visualisation/rapids_tsne/

# Local-only
.claude/
nohup.out
*.log
*.pid

# Revision working area (reviewer PDFs, point-by-point draft, checklists) — local only
revision/

# Citation metadata: prepared but withheld until acceptance (author names / paper DOI)
CITATION.cff

# LLM-stage development checkout, cloned in-tree for integration work.
# Separate git repo with its own history — never commit it into LitDD.
upgraded-octo-happiness/

# Reference data downloaded at setup (see litdd/genes.py for URLs)
data/reference/

# Offline wheelhouses staged for GPU pods (no egress from the cluster). Wheels are
# ABI-specific, so there is one per target image Python:
#   data/wheelhouse/       cp310 -- nvcr.io/nvidia/pytorch:24.10-py3 (training/eval jobs)
#   data/wheelhouse_py311/ cp311 -- python:3.11-slim (CPU ingest: XML->parquet, dedupe)
#   data/wheelhouse_py312/ cp312 -- vllm/vllm-openai (screen + LLM stages; the image ships
#                          neither datasets nor pyarrow nor pandas, which the screen needs
#                          for streaming). Superseded once the container image lands.
# Rebuild with e.g.
#   python -m pip download --only-binary=:all: --python-version 312 --implementation cp \
#     --abi cp312 --platform manylinux_2_17_x86_64 --platform any -d data/wheelhouse_py312 \
#     datasets pyarrow pandas
data/wheelhouse/
data/wheelhouse_py312/
data/wheelhouse_py311/
.pylibs/
.pylibs311/
